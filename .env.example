# ─────────────────────────────────────────────────────────────────────────────
# Speedy Loan Finance Services — environment template
# Copy to .env.local for local development.
# Production values go to Vercel → Project → Settings → Environment Variables.
# Never commit real keys: .env*.local is git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the site. Keep it as the apex domain so canonical URLs,
# Open Graph URLs and JSON-LD @id values match the primary domain in Vercel.
NEXT_PUBLIC_SITE_URL=https://speedyloanfinance.com

# ── Supabase (bank / lead data) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── Google Gemini (powers /api/chat and the RAG chatbot) ─────────────────────
# Required in production, otherwise /api/chat returns 500.
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key

# ── AI Voice Advisor (/api/voice/*) ──────────────────────────────────────────
# Twilio Programmable Voice places the outbound call. Use a +91 number that
# Twilio has verified for India; it appears as the caller ID.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+91XXXXXXXXXX

# Natural Pune/Mumbai female voice. If these are blank the agent falls back to
# Twilio's built-in Polly.Aditi (Indian English / Hindi).
# Model eleven_multilingual_v2 covers English, Hindi and Marathi.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Signs generated speech URLs (defaults to TWILIO_AUTH_TOKEN when omitted).
VOICE_TTS_SECRET=

# Lead delivery on WhatsApp. On a trial account the receiving number must first\n# join the Twilio WhatsApp sandbox (send: join <your-sandbox-code> to +1 415 523 8886).\nTWILIO_WHATSAPP_FROM=whatsapp:+14155238886\nVOICE_LEAD_WHATSAPP=+917350005590\n\n# Number the AI transfers to when the caller asks for a human.
VOICE_HANDOFF_NUMBER=+917350005590

# Optional: when set, the on-page leads panel requires this key to show full lead details.\n# Leave empty for local testing (numbers stay masked either way for the public).\nVOICE_ADMIN_TOKEN=\n\n# Optional server-side key for writing call logs (bypasses row-level security).
SUPABASE_SERVICE_ROLE_KEY=
